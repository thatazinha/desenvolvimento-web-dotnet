@model DW01.Models.Produto
@{
    ViewData["Title"] = "Produtos";
}

<div class="text-center">
    <h1>Produtos</h1>

    <p>Gerenciamento de produtos do sistema.</p>

    <form asp-action="CriarProduto" method="post">

        <div>
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome"></span>
        </div>

        <div>
            <label asp-for="Preco"></label>
            <input asp-for="Preco" />
            <span asp-validation-for="Preco"></span>
        </div>

        <button type="submit">Cadastrar</button>

    </form>

    <br />
    <a asp-controller="Home" asp-action="BuscarProduto"> Buscar Produto </a>
</div>

